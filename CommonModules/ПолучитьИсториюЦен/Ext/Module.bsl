&НаСервере
Функция СформироватьСписокАкций() Экспорт
	СекцияРынка 	= "shares";
	КонецПериода 	= ТекущаяДата() - 86400;

	Запрос = Новый запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Акции.Ссылка КАК Ссылка,
	|	Акции.Тикер КАК Тикер,
	|	Акции.ПометкаУдаления КАК ПометкаУдаления,
	|	Акции.ЗагружатьКурс КАК ЗагружатьКурс,
	|	КотировкиДеньСрезПоследних.Период КАК Период
	|ИЗ
	|	Справочник.Акции КАК Акции
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиДень.СрезПоследних КАК КотировкиДеньСрезПоследних
	|		ПО (Акции.Ссылка = КотировкиДеньСрезПоследних.Акция)
	|ГДЕ
	|	Акции.ПометкаУдаления = ЛОЖЬ
	|	И Акции.ЗагружатьКурс = ИСТИНА";
	РезультатЗапроса = Запрос.Выполнить();
		Если РезультатЗапроса.Пустой() Тогда
			Возврат Ложь;
		КонецЕсли;
		ТаблицаАкции = РезультатЗапроса.Выбрать();
		
	Пока  ТаблицаАкции.Следующий() Цикл
		КодИнструмента 	= ТаблицаАкции.Тикер;
		СсылкаАкция		= ТаблицаАкции.Ссылка;
		ДатаКонцаПериода = ТаблицаАкции.Период;
		Если ЗначениеЗаполнено(ДатаКонцаПериода) Тогда
			НачалоПериода =   ДатаКонцаПериода;
		Иначе
			НачалоПериода = '2000-01-01';
		КонецЕсли;
		РезультатЗагрузки = ЗагрузитьКотировкиДень(КодИнструмента, НачалоПериода, КонецПериода, СекцияРынка, СсылкаАкция);
		Если РезультатЗагрузки = Истина  Тогда
			Сообщение = Новый СообщениеПользователю();
			Сообщение.Текст = "Курс акции " + КодИнструмента + "загружен.";
			Сообщение.Сообщить();
		Иначе
			Прервать;
			
		КонецЕсли;               
		
	КонецЦикла;
	Возврат РезультатЗагрузки;
КонецФункции // СформироватьСписокАкций()





Функция ЗапросПолучитьДанные(АдресЗапроса, ПоляСДатами = "")
    
    HTTPСоединение = Новый HTTPСоединение("iss.moex.com");
    Запрос = Новый HTTPЗапрос("/iss/" + АдресЗапроса);
    Попытка
        Ответ = HTTPСоединение.Получить(Запрос);
        Если Ответ.КодСостояния <> 200 тогда
            Возврат Неопределено;
        КонецЕсли;
        Чтение = Новый ЧтениеJSON;
        Чтение.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку());
        Данные = ПрочитатьJSON(Чтение, Ложь, ПоляСДатами);
        Чтение.Закрыть();
    Исключение
        Возврат Неопределено;
    КонецПопытки;
    
    Возврат Данные;
    
КонецФункции

Функция ОчиститьДату(СтрДата)
    
    Возврат СтрЗаменить(СтрЗаменить(СтрЗаменить(СтрДата, "-", ""), " ", ""), ":", "");
    
КонецФункции

Функция ЗагрузитьКотировкиДень(КодИнструмента, НачалоПериода, КонецПериода, СекцияРынка, СсылкаАкция) Экспорт
    
    СтрокаЗапроса = "engines/stock/markets/"+СекцияРынка+"/securities/" + КодИнструмента + "/candles.json" +
    "?from=" + Формат(НачалоПериода, "ДФ=yyyy-MM-dd") +
    "&till=" + Формат(КонецПериода, "ДФ=yyyy-MM-dd") +
    "&interval=24" +
    "&start=";
    
    // получаем данные порциями по 500
    ТекущаяПозиция = 0;
    
    Пока Истина цикл
        
        Данные = ЗапросПолучитьДанные(СтрокаЗапроса + Формат(ТекущаяПозиция, "ЧГ=0"));
        
        Если Данные = Неопределено тогда
            Сообщение = Новый СообщениеПользователю();
            Сообщение.Текст = "Не удалось загрузить данные";
            Сообщение.Сообщить();
            Возврат Ложь;
        КонецЕсли;
        
        Если Данные.candles.data.Количество() = 0 тогда
            Возврат Истина;
        КонецЕсли;
        
        Для каждого Свеча из Данные.candles.data цикл
            
            ЗаписьКотировки = РегистрыСведений.КотировкиДень.СоздатьМенеджерЗаписи();
            ЗаписьКотировки.Период = ОчиститьДату(Свеча[6]);
			
            ЗаписьКотировки.Акция = СсылкаАкция;
            ЗаписьКотировки.ЦенаO = Свеча[0];
            ЗаписьКотировки.ЦенаC = Свеча[1];
            ЗаписьКотировки.ЦенаH = Свеча[2];
            ЗаписьКотировки.ЦенаL = Свеча[3];
            ЗаписьКотировки.Value = Свеча[4];
            ЗаписьКотировки.Volume = Свеча[5];
            ЗаписьКотировки.Записать();
            
        КонецЦикла;
        
        ТекущаяПозиция = ТекущаяПозиция + 500;
        
    КонецЦикла;
    
    Возврат Истина;
    
КонецФункции


