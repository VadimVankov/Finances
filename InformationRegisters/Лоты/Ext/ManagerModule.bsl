Функция ПолучитьАктуальноеКоличествоАкцийВЛоте(Акция, ПериодОтбора)  Экспорт
	
	КоличествоАкций = 0;
	
	Отбор = Новый Структура("Акция",Акция);
    ТаблицаКоличество = СрезПоследних(ПериодОтбора, Отбор);
	
	Если ТаблицаКоличество.Количество() > 0 Тогда
		    КоличествоАкций = ТаблицаКоличество.Итог("Количество");
			
	КонецЕсли;
	   Возврат КоличествоАкций;

КонецФункции // ПолучитьАктуальноеКоличествоАкцийВЛоте()
